{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.getGenre",
  "description": "Get a hydrated view of a genre record.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the genre record."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["genre"],
          "properties": {
            "genre": {
              "type": "ref",
              "ref": "net.olamaelcu.livtet.biblio.defs#genreView"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "No genre record exists at the given AT-URI."
        }
      ]
    }
  }
}
