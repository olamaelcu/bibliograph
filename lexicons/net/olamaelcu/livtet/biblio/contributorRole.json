{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.contributorRole",
  "description": "Role or title a contributor holds for a book.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxGraphemes": 64,
            "description": "Display name of the role, e.g. 'Translator'."
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "description": "What this role entails."
          },
          "sortName": {
            "type": "string",
            "maxGraphemes": 64,
            "description": "Name used for alphabetical sorting."
          },
          "iconImageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Small icon image for the role."
          },
          "createdAt": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
            "description": "Client-declared timestamp when this record was originally created."
          }
        }
      }
    }
  }
}
