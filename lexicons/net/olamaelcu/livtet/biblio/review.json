{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.review",
  "description": "A review of a book.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "book",
          "status"
        ],
        "properties": {
          "book": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#expandedBook",
            "description": "The book being reviewed, with embedded metadata (title, contributors, identifiers)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxGraphemes": 64
            },
            "description": "Tags associated with this review."
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Optional rating from 1 to 5."
          },
          "status": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#readingStatus",
            "description": "Reading status for the book at the time of this review."
          },
          "progress": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#progress",
            "description": "Optional progress indicator."
          },
          "text": {
            "type": "string",
            "maxGraphemes": 65536,
            "description": "The review prose."
          },
          "blobs": {
            "type": "array",
            "items": {
              "type": "blob",
              "accept": [
                "image/*",
                "video/*"
              ],
              "maxSize": 10000000
            },
            "description": "Optional image or video blobs attached to this review."
          },
          "createdAt": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
            "description": "Client-declared timestamp when this record was originally created."
          }
        }
      }
    }
  }
}
