{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.putActor",
  "description": "Create or update the caller's actor profile record (rkey `self`) in their own PDS via this AppView.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "displayName": {
              "type": "string",
              "maxGraphemes": 64,
              "description": "Display name of the user."
            },
            "description": {
              "type": "string",
              "maxGraphemes": 256,
              "description": "Short bio."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          }
        }
      }
    }
  }
}
