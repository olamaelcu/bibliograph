{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.searchWorks",
  "description": "Search work records by title, description, or external identifier.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query string. Matches against title, description, and external identifiers."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum number of works to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["works"],
          "properties": {
            "works": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#workView"
              }
            },
            "hitsTotal": {
              "type": "integer",
              "description": "Total number of matching works. May be rounded or truncated."
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
