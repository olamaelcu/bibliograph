{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.bookContributor",
  "description": "Join record linking a book to a contributor and their role.",
  "defs": {
    "main": {
      "type": "record",
      "key": "string",
      "record": {
        "type": "object",
        "required": [
          "book",
          "contributor",
          "role"
        ],
        "properties": {
          "book": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the book record."
          },
          "contributor": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the contributor record."
          },
          "role": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.contributorRole",
            "strong": true,
            "description": "The role the contributor holds for this book."
          }
        }
      }
    }
  }
}
