{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.searchContributors",
  "description": "Search contributor records by name, sort name, or biography.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query string. Matches against display name, sort name, and biography."
          },
          "role": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of a contributor role; only return contributors holding this role on at least one book."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum number of contributors to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["contributors"],
          "properties": {
            "contributors": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#contributorView"
              }
            },
            "hitsTotal": {
              "type": "integer",
              "description": "Total number of matching contributors. May be rounded or truncated."
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
