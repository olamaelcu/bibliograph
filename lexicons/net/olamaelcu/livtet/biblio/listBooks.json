{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.listBooks",
  "description": "List book records, optionally filtered by genre, format, or reading status.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "description": "Free-text search passed through to Google Books."
          },
          "genre": {
            "type": "string",
            "format": "at-uri",
            "description": "Only include books in the given genre."
          },
          "contributor": {
            "type": "string",
            "format": "at-uri",
            "description": "Only include books that credit the given contributor (in any role)."
          },
          "format": {
            "type": "string",
            "format": "at-uri",
            "description": "Only include books in the given format."
          },
          "status": {
            "type": "string",
            "knownValues": [
              "reading",
              "to-read",
              "dnf",
              "read"
            ],
            "description": "Only include books with reviews in the given reading status."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of books to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["books"],
          "properties": {
            "books": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#bookView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
