{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.work",
  "description": "A literary work (conceptual book) that multiple editions can belong to.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxGraphemes": 300,
            "description": "Title of the work."
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "net.olamaelcu.livtet.biblio.defs#identifier"
            },
            "description": "External identifiers for the work, such as an Open Library work key."
          },
          "description": {
            "type": "string",
            "maxGraphemes": 8192,
            "description": "Description or synopsis of the work."
          },
          "originalPublishDate": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
            "description": "Date of first publication of the work."
          },
          "createdAt": {
            "type": "ref",
            "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
            "description": "Client-declared timestamp when this record was originally created."
          }
        }
      }
    }
  }
}
