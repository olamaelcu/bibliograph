{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.putShelf",
  "description": "Create or update a shelf in the caller's own PDS via this AppView. The record key is derived from the supplied slug, or generated when omitted.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "rkey": {
              "type": "string",
              "format": "record-key",
              "maxLength": 512,
              "description": "Optional record key (a name slug). Derived from the name when omitted."
            },
            "name": {
              "type": "string",
              "maxGraphemes": 128,
              "description": "Display name of the shelf."
            },
            "description": {
              "type": "string",
              "maxGraphemes": 8192,
              "description": "Description of the shelf."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "cid": {
              "type": "string",
              "format": "cid"
            }
          }
        }
      }
    }
  }
}
