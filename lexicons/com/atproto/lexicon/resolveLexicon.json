{
  "lexicon": 1,
  "id": "com.atproto.lexicon.resolveLexicon",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["nsid"],
        "properties": {
          "nsid": {
            "type": "string",
            "description": "The NSID of the lexicon to resolve."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid", "schema"],
          "properties": {
            "uri": {
              "type": "string"
            },
            "cid": {
              "type": "string"
            },
            "schema": {
              "type": "ref",
              "ref": "com.atproto.lexicon.schema"
            }
          }
        }
      },
      "errors": [
        {
          "name": "LexiconNotFound",
          "description": "The requested lexicon NSID is not available."
        }
      ]
    }
  }
}
