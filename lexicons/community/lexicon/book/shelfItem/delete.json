{
  "lexicon": 1,
  "id": "community.lexicon.book.shelfItem.delete",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["shelfUri", "bookUri"],
          "properties": {
            "shelfUri": { "type": "string", "format": "at-uri" },
            "bookUri": { "type": "string", "format": "at-uri" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" }
          }
        }
      },
      "errors": [
        { "name": "ShelfNotFound" },
        { "name": "Forbidden" },
        { "name": "NotFound" },
        { "name": "InvalidInput" }
      ]
    }
  }
}
