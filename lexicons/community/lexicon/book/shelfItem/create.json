{
  "lexicon": 1,
  "id": "community.lexicon.book.shelfItem.create",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["shelfUri", "bookUri"],
          "properties": {
            "shelfUri": { "type": "string", "format": "at-uri" },
            "bookUri": { "type": "string", "format": "at-uri" },
            "note": { "type": "string", "maxLength": 500 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      },
      "errors": [
        { "name": "ShelfNotFound" },
        { "name": "BookNotFound" },
        { "name": "Forbidden" },
        { "name": "DuplicateShelfItem" },
        { "name": "InvalidInput" }
      ]
    }
  }
}
