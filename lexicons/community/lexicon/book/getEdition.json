{
  "lexicon": 1,
  "id": "community.lexicon.book.getEdition",
  "description": "Fetch an edition record by its AT-URI.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["edition"],
          "properties": {
            "edition": {
              "type": "ref",
              "ref": "community.lexicon.book.edition"
            }
          }
        }
      }
    }
  }
}