{
  "lexicon": 1,
  "id": "community.lexicon.book.book.search",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "q": { "type": "string" },
          "identifier": {
            "type": "string",
            "description": "Comma-separated list of identifier types to search (e.g., 'isbn,oclc,asin')"
          },
          "includeUnverified": {
            "type": "boolean",
            "default": false,
            "description": "Include unverified claims in identifier search"
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["books"],
          "properties": {
            "books": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uri", "record"],
                "properties": {
                  "uri": { "type": "string", "format": "at-uri" },
                  "record": { "type": "object" }
                }
              }
            },
            "cursor": { "type": "string" },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
