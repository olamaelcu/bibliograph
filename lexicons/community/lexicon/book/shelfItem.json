{
  "lexicon": 1,
  "id": "community.lexicon.book.shelfItem",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["shelfUri", "bookUri", "bookRef", "createdAt"],
        "properties": {
          "shelfUri": { "type": "string", "format": "at-uri" },
          "bookUri": { "type": "string", "format": "at-uri" },
          "bookRef": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" },
          "note": { "type": "string", "maxLength": 500 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
