{
  "lexicon": 1,
  "id": "community.lexicon.book.claim",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["bookUri", "identifier", "identifierType", "claimedBy", "createdAt"],
        "properties": {
          "bookUri": { "type": "string", "format": "at-uri" },
          "isbn": { "type": "string" },
          "identifier": { "type": "string" },
          "identifierType": {
            "type": "string",
            "enum": ["isbn", "ean", "issn"]
          },
          "claimedBy": { "type": "string", "format": "did" },
          "status": {
            "type": "string",
            "enum": ["pending", "verified", "rejected"]
          },
          "verifiedBy": { "type": "string", "format": "did" },
          "verifiedAt": { "type": "string", "format": "datetime" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
