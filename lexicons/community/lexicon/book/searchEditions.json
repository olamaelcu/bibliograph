{
  "lexicon": 1,
  "id": "community.lexicon.book.searchEditions",
  "description": "Search editions by free-form text or by identifiers.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Search editions. Required query for bibliographic AppViews.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 1024,
            "maxGraphemes": 256
          },
          "id": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            },
            "maxLength": 32
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "community.lexicon.book.edition"
              }
            },
            "total": {
              "type": "integer"
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}