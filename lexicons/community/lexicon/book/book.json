{
  "lexicon": 1,
  "id": "community.lexicon.book.book",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "author", "createdAt", "updatedAt"],
        "properties": {
          "title": { "type": "string" },
          "author": { "type": "string" },
          "isbn": { "type": "string" },
          "publishedDate": { "type": "string", "format": "datetime" },
          "description": { "type": "string", "maxLength": 4096 },
          "pageCount": { "type": "integer" },
          "language": { "type": "string" },
          "categories": {
            "type": "array",
            "items": { "type": "string" }
          },
          "coverUrl": { "type": "string", "format": "uri" },
          "deduplicationHash": { "type": "string" },
          "contributors": {
            "type": "array",
            "items": { "type": "ref", "ref": "#bookContributorEntry" }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "rejected"]
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "bookContributorEntry": {
      "type": "object",
      "required": ["contributor", "role"],
      "properties": {
        "contributor": { "type": "ref", "ref": "#strongRef" },
        "role": { "type": "ref", "ref": "#strongRef" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "strongRef": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" }
      }
    }
  }
}
