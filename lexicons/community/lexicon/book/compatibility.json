{
  "lexicon": 1,
  "id": "community.lexicon.book.compatibility",
  "description": "Discover which lexicon queries a bibliographic AppView supports.",
  "defs": {
    "queryRef": {
      "type": "object",
      "required": ["nsid"],
      "properties": {
        "nsid": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "knownValues": ["query", "procedure"]
        }
      }
    },
    "main": {
      "type": "query",
      "description": "List all queries this AppView implements. Required.",
      "parameters": {
        "type": "params",
        "properties": {
          "includePrivate": {
            "type": "boolean",
            "default": false,
            "description": "Include app-private (non-community) queries in the response."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["queries"],
          "properties": {
            "queries": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#queryRef"
              }
            }
          }
        }
      }
    }
  }
}