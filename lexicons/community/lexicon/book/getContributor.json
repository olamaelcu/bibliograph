{
  "lexicon": 1,
  "id": "community.lexicon.book.getContributor",
  "description": "Fetch a contributor record by its AT-URI.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["contributor"],
          "properties": {
            "contributor": {
              "type": "ref",
              "ref": "community.lexicon.book.contributor"
            }
          }
        }
      }
    }
  }
}