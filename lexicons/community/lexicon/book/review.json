{
  "lexicon": 1,
  "id": "community.lexicon.book.review",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["bookUri", "text", "createdAt", "bookRef"],
        "properties": {
          "bookUri": { "type": "string", "format": "at-uri" },
          "text": { "type": "string", "maxLength": 4096 },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "bookRef": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
