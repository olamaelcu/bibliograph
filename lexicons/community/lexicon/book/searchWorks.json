{
  "lexicon": 1,
  "id": "community.lexicon.book.searchWorks",
  "description": "Search works. Optional; this AppView returns 501.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["q"],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 1024,
            "maxGraphemes": 256
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "community.lexicon.book.work"
              }
            },
            "total": {
              "type": "integer"
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}