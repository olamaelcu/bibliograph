{
  "lexicon": 1,
  "id": "community.lexicon.book.createStatus",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "bookUri": { "type": "string", "format": "at-uri" },
            "identifiers": {
              "type": "array",
              "items": { "type": "ref", "ref": "community.lexicon.book.defs#identifier" }
            },
            "status": {
              "type": "string",
              "enum": ["reading", "read", "to-read", "abandoned"]
            },
            "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
            "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
            "startedAt": { "type": "string", "format": "datetime" },
            "finishedAt": { "type": "string", "format": "datetime" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": { "type": "string", "format": "at-uri" },
            "cid": { "type": "string", "format": "cid" }
          }
        }
      },
      "errors": [
        { "name": "BookNotFound" },
        { "name": "StatusAlreadyExists" }
      ]
    }
  }
}
