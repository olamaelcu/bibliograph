{
  "lexicon": 1,
  "id": "community.lexicon.book.revokeLibrarian",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid"],
          "properties": {
            "targetDid": { "type": "string", "format": "did" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "librarian"],
          "properties": {
            "ok": { "type": "boolean", "const": true },
            "librarian": { "type": "string", "format": "did" }
          }
        }
      },
      "errors": [
        { "name": "InvalidInput" },
        { "name": "Forbidden" }
      ]
    }
  }
}
