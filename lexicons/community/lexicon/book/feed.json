{
  "lexicon": 1,
  "id": "community.lexicon.book.feed",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 25 },
          "cursor": { "type": "string" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["recent", "newestBooks", "trending"],
          "properties": {
            "recent": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "did", "uri", "book", "createdAt"],
                "properties": {
                  "type": { "type": "string", "enum": ["review", "status"] },
                  "did": { "type": "string", "format": "did" },
                  "uri": { "type": "string", "format": "at-uri" },
                  "book": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" },
                  "createdAt": { "type": "string", "format": "datetime" }
                }
              }
            },
            "newestBooks": {
              "type": "array",
              "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" }
            },
            "trending": {
              "type": "object",
              "required": ["day", "week", "month"],
              "properties": {
                "day": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } },
                "week": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } },
                "month": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } }
              }
            },
            "following": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } },
            "crossUser": {
              "type": "object",
              "required": ["day", "week", "month"],
              "properties": {
                "day": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } },
                "week": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } },
                "month": { "type": "array", "items": { "type": "ref", "ref": "community.lexicon.book.defs#bookRef" } }
              }
            },
            "degraded": { "type": "boolean" },
            "cursor": { "type": "string" }
          }
        }
      }
    }
  }
}
