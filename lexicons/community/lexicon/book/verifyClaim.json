{
  "lexicon": 1,
  "id": "community.lexicon.book.verifyClaim",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["claimUri"],
          "properties": {
            "claimUri": { "type": "string", "format": "at-uri" }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok", "bookUri", "claimedBy"],
          "properties": {
            "ok": { "type": "boolean", "const": true },
            "bookUri": { "type": "string", "format": "at-uri" },
            "claimedBy": { "type": "string", "format": "did" }
          }
        }
      },
      "errors": [
        { "name": "InvalidInput" },
        { "name": "NotFound" },
        { "name": "AlreadyVerified" }
      ]
    }
  }
}
