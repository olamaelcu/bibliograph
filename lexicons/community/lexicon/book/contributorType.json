{
  "lexicon": 1,
  "id": "community.lexicon.book.contributorType",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 256 },
          "description": { "type": "string", "maxLength": 16384 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
