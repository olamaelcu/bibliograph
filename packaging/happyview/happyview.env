# HappyView configuration, read by happyview.service and by the deploy oneshot.
# This file is a dpkg conffile: local edits survive upgrades.
#
# Ansible-managed hosts leave this file untouched and write
# /etc/bibliograph/happyview.local instead, which the units load *after* this
# one and which therefore wins. That keeps the conffile pristine for dpkg.
#
# DATABASE_URL is the only entry that must be set. The role it names must have
# `search_path = happyview, public` as its default, because HappyView's
# migrations and queries are unqualified and would otherwise land in `public`.
# db-init.sql in /usr/share/bibliograph-happyview creates the role and schema.
DATABASE_URL=

# The service is loopback-only: the SvelteKit application is the public origin
# and proxies /xrpc here. A loopback PUBLIC_URL keeps HappyView's OAuth client
# in the localhost form, which needs no client-metadata fetch.
PUBLIC_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
STATIC_DIR=/usr/lib/bibliograph-happyview/static

# Signs dashboard session cookies; must be at least 64 characters.
SESSION_SECRET=
# AES-256-GCM key (base64, exactly 32 bytes) for OAuth tokens and DPoP keys at
# rest. Without it, DPoP sessions and spaces are disabled.
TOKEN_ENCRYPTION_KEY=

# Network sync. Point these at a local relay when the host must not reach the
# public network; an unreachable Jetstream only logs a warning.
JETSTREAM_URL=wss://jetstream1.us-east.bsky.network
RELAY_URL=https://bsky.network
# PLC_URL=https://plc.directory
# ALLOW_PRIVATE_DESTINATIONS=false

RUST_LOG=happyview=info,tower_http=info,sqlx=warn

# Where the deploy oneshot keeps the admin key it generates on first run. The
# file is created 0600 and owned by the service user.
HAPPYVIEW_ADMIN_KEY_FILE=/etc/bibliograph/happyview-admin.key
# DID recorded for the seeded administrator, used by the dashboard's first
# login. Defaults to did:web:<hostname>.
# HV_ADMIN_DID=did:web:example.org
