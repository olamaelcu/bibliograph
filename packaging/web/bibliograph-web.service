[Unit]
Description=Bibliograph web edge (SvelteKit)
Documentation=https://github.com/olamaelcu/bibliograph
Wants=network-online.target
# Order-only, deliberately not Wants=: Depends: names only nodejs and
# bibliograph-happyview, and DATABASE_URL may point at a remote cluster, so a
# local postgresql.service is not required (happyview only Recommends:
# postgresql). Where it does exist, multi-user.target pulls it in and this
# ordering keeps the edge from starting before the cluster accepts
# connections. The catalog routes query Postgres directly, so without it a boot
# leaves those requests failing until the cluster comes up.
After=network-online.target postgresql.service

[Service]
Type=simple
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph-web
EnvironmentFile=/etc/bibliograph/web.env
# Written by the HappyView package; later files win, so the generated pair
# overrides anything stale in web.env.
EnvironmentFile=-/etc/bibliograph/happyview-client.env
ExecStart=/usr/bin/node /usr/lib/bibliograph-web/build/index.js
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# The edge holds no state: upstream is HappyView, configuration is the
# conffile, and it writes nothing. The whole filesystem can stay read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
