#!/bin/sh
# Hand-assembled package: debhelper does not run, so the unit is enabled and
# started with deb-systemd-helper/-invoke, which is what debhelper's generated
# snippets call. Using systemctl directly here would trip lintian and skip the
# package's state tracking.
set -e

# Shared with the bibliograph and bibliograph-happyview packages.
if ! getent group bibliograph >/dev/null; then
    addgroup --system bibliograph
fi
if ! getent passwd bibliograph >/dev/null; then
    adduser --system --ingroup bibliograph --home /var/lib/bibliograph \
        --no-create-home --disabled-login --gecos "Bibliograph appview" bibliograph
fi

install -d -m 0750 -o root -g bibliograph /etc/bibliograph

if [ -d /run/systemd/system ]; then
    deb-systemd-helper daemon-reload >/dev/null 2>&1 || true
    deb-systemd-helper enable bibliograph-web.service >/dev/null 2>&1 || true
    deb-systemd-invoke restart bibliograph-web.service >/dev/null 2>&1 || true
fi

# The pair normally comes from the HappyView package's generated file; web.env
# can override it. Warn only when neither supplies a key, because the proxy
# then reaches HappyView unattributed.
client_key_configured() {
    for file in /etc/bibliograph/happyview-client.env /etc/bibliograph/web.env; do
        [ -r "$file" ] && grep -Eq '^HAPPYVIEW_CLIENT_KEY=..+' "$file" && return 0
    done
    return 1
}

if ! client_key_configured; then
    echo "bibliograph-web: no HAPPYVIEW_CLIENT_KEY in web.env or" >&2
    echo "bibliograph-web: happyview-client.env; proxied requests will reach" >&2
    echo "bibliograph-web: HappyView unauthenticated. Install" >&2
    echo "bibliograph-web: bibliograph-happyview and restart it to generate one." >&2
fi

exit 0
