# Bibliograph web edge configuration, read by bibliograph-web.service.
# This file is a dpkg conffile: local edits survive upgrades.

HOST=127.0.0.1
PORT=5176

# HappyView upstream. The edge injects its own client identity on every proxy
# request, so credentials never reach the browser.
#
# The `hvc_`/`hvs_` pair is generated by the HappyView package
# (bibliograph-happyview-client.service) into
# /etc/bibliograph/happyview-client.env, which this unit also loads — after this
# file, so it wins. Set the pair here only to override it.
# When HappyView runs with BASE_PATH, include it here as well, e.g.
# HAPPYVIEW_URL=http://127.0.0.1:3100/hv. If its PUBLIC_URL is not a loopback
# name, HappyView no longer accepts Host: 127.0.0.1 and the edge must go
# through the loopback adapter in packaging/happyview/nginx/edge-loopback.conf
# (http://127.0.0.1:3101/hv), which rewrites Host to the registered domain.
HAPPYVIEW_URL=http://127.0.0.1:3000

# ───── Feed generator ───────────────────────────────────────────────────────
# DID advertised by com.atproto.feed.describeFeedGenerator and the authority of
# every feed URI. Personalized feeds require an atproto service JWT with
# aud=<FEED_GENERATOR_DID>#atproto_feed; its signature is verified against the
# issuer DID document's #atproto Multikey.
#
# Required, with no code default: the operator must set the deployment's DID
# here. When it is empty, both feed methods answer 503 ServiceUnavailable.
FEED_GENERATOR_DID=
# PLC directory used to resolve did:plc signer DIDs for the personalized feeds.
# Required for following/extended/dynamic, with no code default: the operator
# must set it (for the public PLC, https://plc.directory). When it is empty,
# those three feeds answer 503 ServiceUnavailable; `public` does not need it.
PLC_URL=

# Catalog database for the anonymous books-wg procedures
# (community.lexicon.media.book.{resolveEditions,searchEditions}). The role
# needs SELECT on the catalog tables only; it is separate from HappyView's
# DATABASE_URL. Leave unset to answer those two methods with 503 instead of
# taking the whole edge down.
#DATABASE_URL=postgres://bibliograph-web:CHANGEME@127.0.0.1:5432/bibliograph

# Publisher PDS. GET /xrpc/com.atproto.repo.getRecord and listRecords are
# proxied here so clients can read publisher records through the edge. Set the
# deployment's PDS base URL; leave unset to answer those two reads with 503.
#PDS_URL=https://pds.example.org

# adapter-node derives absolute URLs from the incoming connection, which behind
# the packaged TLS vhost is plain HTTP on loopback. Set ORIGIN, or let the vhost's
# X-Forwarded-* headers be trusted with
# PROTOCOL_HEADER=x-forwarded-proto and HOST_HEADER=x-forwarded-host, so
# redirects and absolute URLs use the public https origin. For this deployment
# that is ORIGIN=https://biblio.livtet.olamaelcu.net.
#ORIGIN=

# ───── Admin curation UI (/admin) ───────────────────────────────────────────
# Operator token. When unset the whole /admin area and /admin/api/* answer
# 404, so the web package can be installed without an admin surface. The token
# is compared server-side and stored in an HttpOnly, SameSite=Strict cookie;
# it is never rendered into HTML or exposed to browser JavaScript. Set the same
# value in worker.env so the edge can call the worker's admin API.
#ADMIN_TOKEN=

# Loopback base URL of the worker admin API (provider search + ingest). The
# worker binds it to WORKER_ADMIN_HOST:WORKER_ADMIN_PORT (default
# 127.0.0.1:9465). Never expose that port through the public vhost.
#WORKER_ADMIN_URL=http://127.0.0.1:9465

NODE_ENV=production
