# Bibliograph worker configuration, read by bibliograph-worker.service.
# This file is a dpkg conffile: local edits survive upgrades.

# ───── Required: database ───────────────────────────────────────────────────
# The worker owns the graphile_worker schema, the catalog_enqueue_marks table,
# and the pds_outbox drain. It needs write access to the catalog tables.
#DATABASE_URL=postgres://bibliograph:CHANGEME@127.0.0.1:5432/bibliograph

NODE_ENV=production
GRAPHILE_WORKER_CONCURRENCY=5

# ───── PDS publisher (`pds-publish`) ────────────────────────────────────────
# The publisher identity is the account whose repo carries the edition
# records. ATP_SERVICE_DID is the production publisher identity (a did:plc
# account for this deployment) and the authority in each new edition URI; keep
# it stable after the catalog is populated. ATP_SERVICE_HOST only supplies the
# did:web fallback used when ATP_SERVICE_DID is unset (local/test).
#ATP_SERVICE_DID=did:plc:<publisher-account-did>
ATP_SERVICE_HOST=biblio.livtet.olamaelcu.net

# Required for publishing. There is deliberately no usable default: this must
# be the PDS that owns the publisher account, because the account session is the
# only thing authorising the write.
#PDS_URL=https://pds.example.org
#
# Local compose example (not a production default — the TLS name is loopback):
#PDS_URL=https://pds.127-0-0-1.sslip.io
#PDS_URL=http://127.0.0.1:2583
#
# The account must own the repo named above; an app password is created from the
# PDS account settings, not the account password.
#PDS_ACCOUNT_DID=did:plc:<publisher-account-did>
#PDS_ACCOUNT_PASSWORD=

# Alternative to PDS_ACCOUNT_PASSWORD: a provisioned session. With a token the
# worker verifies it with com.atproto.server.getSession and never stores the
# account password.
#PDS_ACCESS_TOKEN=
#PDS_REFRESH_TOKEN=

# ───── Catalog providers (optional) ─────────────────────────────────────────
#GOOGLE_BOOKS_API_KEY=
#ISBNDB_API_KEY=
# ISBNdb bills per call. The worker reserves one call per cache miss and stops
# contacting ISBNdb after this many calls in a UTC day; cache hits do not
# count. 0/negative is invalid and falls back to 5000 with a warning.
#ISBNDB_DAILY_LIMIT=5000
#GOODREADS_BASE_URL=https://www.goodreads.com

# ───── Prometheus metrics ───────────────────────────────────────────────────
# Dependency-free /metrics endpoint exposing the ISBNdb daily-usage gauges.
# Loopback by default: set WORKER_METRICS_HOST=0.0.0.0 only when a scraper on
# another host or container must reach it, and open the firewall accordingly.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1

# ───── Admin API (catalog curation) ─────────────────────────────────────────
# The web edge's /admin UI proxies provider search and ingest here. The API is
# disabled when ADMIN_TOKEN is unset (it logs that fact at boot); set the same
# token in web.env. Keep the listener loopback-only: it can write the catalog.
#ADMIN_TOKEN=
WORKER_ADMIN_HOST=127.0.0.1
WORKER_ADMIN_PORT=9465
