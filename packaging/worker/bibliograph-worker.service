[Unit]
Description=Bibliograph catalog worker (provider hydration + PDS outbox)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph-worker
Environment=NODE_ENV=production
# One worker owns this database, so any graphile lock present at boot was left
# by a killed predecessor and is cleared (see clearStaleGraphileLocks). Remove
# this if a second worker is ever pointed at the same database.
Environment=WORKER_CLEAR_STALE_LOCKS=1
EnvironmentFile=-/etc/bibliograph/worker.env
ExecStart=/usr/bin/node /usr/lib/bibliograph-worker/index.js

# The worker drains the PDS outbox, so an upstream outage must not exhaust the
# start limit: restart gently and keep trying.
Restart=on-failure
RestartSec=10s
# graphile-worker handles SIGTERM and exits 0; these cover the boot window
# before its signal handlers are installed.
SuccessExitStatus=143 130
# Graphile stops fetching on SIGTERM and aborts in-flight jobs after
# `gracefulShutdownAbortTimeout` (30 s, set in index.js). The jobs it is asked
# to stop — a batched pds-publish drain, a catalog.bookhive walk — observe the
# abort at their next claim or page boundary and return, which is what keeps
# their place. systemd must wait past that window: a SIGKILL leaves graphile's
# job and queue locks held for four hours and stalls pds-publish.
KillSignal=SIGTERM
TimeoutStopSec=60s
LimitNOFILE=65536
SyslogIdentifier=bibliograph-worker

StateDirectory=bibliograph
StateDirectoryMode=0750
LogsDirectory=bibliograph
LogsDirectoryMode=0750

# Cached cover images. systemd creates and owns this directory, so the worker
# can write it under ProtectSystem=strict; bibliograph-web reads the same path
# (its own unit is read-only and only ever stats/reads here). The cache is
# unbounded by design — growth is reported as textfile metrics, not evicted.
CacheDirectory=bibliograph-covers
CacheDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
