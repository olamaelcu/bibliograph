# Bibliograph search index configuration, read by
# bibliograph-search.service. This file is a dpkg conffile: local edits survive
# upgrades.
#
# The service listens on loopback only. The worker POSTs documents to it and the
# edge POSTs queries; nothing outside the host reaches this port. The index
# directory holds derived data: deleting it costs a rebuild
# (`mise run search-backfill`), never catalog data.

SEARCH_BIND=127.0.0.1:3103
SEARCH_INDEX_DIR=/var/lib/bibliograph-search/index
