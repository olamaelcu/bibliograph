{
  "name": "bibliograph-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "lex-cli generate && vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "worker": "tsx worker.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lex:gen": "lex-cli generate",
    "verify:lex": "tsx scripts/verify-resolver.ts",
    "verify:search": "tsx --test scripts/verify-search.ts",
    "verify:server": "tsx --test scripts/verify-server.ts",
    "verify:tap-jobs": "tsx --test scripts/verify-tap-jobs.ts",
    "worker:search": "tsx worker-search-jobs.ts",
    "backfill:works": "tsx scripts/backfill-works.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/lexicon-resolver": "^1.0.1",
    "@atcute/lexicons": "^2.1.0",
    "@atcute/tap": "^1.0.2",
    "@atcute/xrpc-server": "^2.0.2",
    "@atproto/common-web": "^0.5.9",
    "@atproto/crypto": "^0.5.4",
    "@atproto/lex-cbor": "^0.1.6",
    "@atproto/lex-data": "^0.1.7",
    "@atproto/repo": "^0.10.11",
    "@awesome.me/webawesome": "^3.12.0",
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.17.3",
    "happy-dom": "^20.11.6",
    "pg": "^8.23.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.12",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@atcute/lex-cli": "^3.3.0",
    "@eslint/js": "^9.18.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "partysocket": "^1.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
