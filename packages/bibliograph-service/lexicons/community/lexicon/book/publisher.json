{
  "lexicon": 1,
  "id": "community.lexicon.book.publisher",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt", "uri"],
        "properties": {
          "uri": { "type": "string", "format": "uri" },
          "name": { "type": "string", "minLength": 1, "maxLength": 256, "maxGraphemes": 200 },
          "imprintOf": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "foundingDate": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "closingDate": { "type": "integer", "minimum": 0, "maximum": 9999 },
          "identifiers": {
            "type": "array",
            "minLength": 0,
            "maxLength": 32,
            "items": { "type": "ref", "ref": "community.lexicon.book.defs#identifier" }
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
