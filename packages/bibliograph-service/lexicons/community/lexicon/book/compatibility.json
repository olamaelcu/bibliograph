{
  "lexicon": 1,
  "id": "community.lexicon.book.compatibility",
  "defs": {
    "main": {
      "type": "query",
      "description": "List XRPC queries/procedures this AppView implements under community.lexicon.book.*.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["queries"],
          "properties": {
            "queries": {
              "type": "array",
              "items": { "type": "ref", "ref": "#queryRef" }
            }
          }
        }
      }
    },
    "queryRef": {
      "type": "object",
      "required": ["nsid"],
      "properties": {
        "nsid": { "type": "string", "format": "nsid" },
        "type": { "type": "string", "knownValues": ["query", "procedure"] }
      }
    }
  }
}
