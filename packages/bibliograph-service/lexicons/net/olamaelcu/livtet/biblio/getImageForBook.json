{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.getImageForBook",
  "description": "Resolve the cover image URL for a book edition by AT-URI.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}