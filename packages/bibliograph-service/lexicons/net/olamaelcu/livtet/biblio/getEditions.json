{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.getEditions",
  "description": "Resolve catalog edition AT-URIs to hydrated book views in one request. Unknown URIs are omitted rather than erroring, so a caller can batch a whole screen of references and map the results by `uri`.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["uris"],
        "properties": {
          "uris": {
            "type": "array",
            "minLength": 1,
            "maxLength": 100,
            "items": {
              "type": "string",
              "format": "at-uri"
            },
            "description": "AT-URIs of the catalog edition records to resolve."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["editions"],
          "properties": {
            "editions": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#bookView"
              }
            }
          }
        }
      }
    }
  }
}
