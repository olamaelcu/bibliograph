{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.graph.isFollowing",
  "description": "Whether one account follows another.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["follower", "followed"],
        "properties": {
          "follower": { "type": "string", "format": "did" },
          "followed": { "type": "string", "format": "did" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["following"],
          "properties": { "following": { "type": "boolean" } }
        }
      }
    }
  }
}
