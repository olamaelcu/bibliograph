{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.graph.listFollowees",
  "description": "List the accounts one account follows.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "followees",
            "total"
          ],
          "properties": {
            "followees": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#followee"
              }
            },
            "total": {
              "type": "integer"
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      }
    },
    "followee": {
      "type": "object",
      "required": [
        "did",
        "followedAt"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "followedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
