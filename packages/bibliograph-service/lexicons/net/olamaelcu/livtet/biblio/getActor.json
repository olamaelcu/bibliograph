{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.getActor",
  "description": "Get the public profile of the authenticated user.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": {
            "type": "string",
            "format": "did",
            "description": "DID of the actor whose profile to fetch."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["actor"],
          "properties": {
            "actor": {
              "type": "ref",
              "ref": "net.olamaelcu.livtet.biblio.defs#actorView"
            }
          }
        }
      }
    }
  }
}
