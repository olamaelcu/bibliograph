{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.listShelfItemsByBook",
  "description": "List the custom-shelf membership records for one book in one reader's repo.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["book", "did"],
        "properties": {
          "book": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the book whose shelf memberships to read."
          },
          "did": {
            "type": "string",
            "format": "did",
            "description": "DID of the reader whose shelves to search."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of shelfItem records to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#shelfItemView"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "InvalidRequest",
          "description": "The book is not an AT-URI or the DID is malformed."
        }
      ]
    }
  }
}
