{
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web http health check",
        "path": "/health",
        "port": 5000,
        "initialDelay": 3,
        "timeout": 5,
        "attempts": 5,
        "wait": 3,
        "content": "ok"
      }
    ]
  },
  "formation": {
    "web": {
      "quantity": 1,
      "max_parallel": 1
    }
  },
  "cron": [
    {
      "command": "tsx src/dedup-job.ts run",
      "schedule": "0 15 * * *",
      "concurrency_policy": "forbid"
    },
    {
      "command": "npm run dump:openlibrary -- --keep-dump",
      "schedule": "0 3 1 * *",
      "concurrency_policy": "forbid"
    },
    {
      "command": "npm run bookhive:catalog",
      "schedule": "0 4 1 * *",
      "concurrency_policy": "forbid"
    },
    {
      "command": "npm run bookhive:activity",
      "schedule": "0 5 1 * *",
      "concurrency_policy": "forbid"
    },
    {
      "command": "npm run bookhive:users",
      "schedule": "0 6 1 * *",
      "concurrency_policy": "forbid"
    },
    {
      "command": "tsx src/cover-worker.ts",
      "schedule": "0 */4 * * *",
      "concurrency_policy": "forbid"
    }
  ]
}
