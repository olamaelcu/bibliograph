{
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web http health check",
        "path": "/health",
        "port": 5000,
        "initialDelay": 3,
        "timeout": 5,
        "attempts": 5,
        "wait": 3,
        "content": "ok"
      }
    ]
  },
  "formation": {
    "web": {
      "quantity": 1,
      "max_parallel": 1
    },
    "worker": {
      "quantity": 1,
      "max_parallel": 1
    }
  },
  "cron": [
    {
      "command": "npm run dump:openlibrary",
      "schedule": "0 3 1 * *",
      "concurrency_policy": "forbid"
    }
  ]
}
