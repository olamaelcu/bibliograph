# Bibliograph service
ORIGIN=http://localhost:5176
DATABASE_URL=postgres://bibliograph:bibliograph@localhost:5432/bibliograph
# Postgres connection budget. The host caps max_connections (50 on the packaged
# host); these maxima keep the app under it. Raise them only with the limit.
# PG_POOL_MAX=5                # web process read pool
# ENQUEUE_POOL_MAX=3           # web process job-enqueue pool
# GRAPHILE_WORKER_POOL=6       # worker pool
BODY_SIZE_LIMIT=100M
PORT=5000
NODE_ENV=development

# ─── Publishing identity ────────────────────────────────────────────────────
# ATProto publisher. Its repo lives on the PDS below. ATP_SERVICE_DID is the
# primary publisher identity — a did:plc account for this deployment — and is
# the authority in every edition URI; it must be stable and match
# PDS_ACCOUNT_DID below when publishing is enabled. When it is unset, the
# authority falls back to did:web:<ATP_SERVICE_HOST>, for local/test only.
#ATP_SERVICE_DID=did:plc:<publisher-account-did>
ATP_SERVICE_HOST=biblio.livtet.olamaelcu.net
ATP_SERVICE_KEY_MULTIBASE=
# `pds-publish` signs in to PDS_URL with an account session: the PDS owns the
# repo signing key. The account must own the publisher DID above. Use an app
# password (PDS_ACCOUNT_PASSWORD) or provision a session (PDS_ACCESS_TOKEN).
# Without these the worker logs that pds-publish is disabled and keeps the
# outbox rows queued; hydration still runs. `mise run worker` starts it.
#PDS_ACCOUNT_DID=did:plc:<publisher-account-did>
#PDS_ACCOUNT_PASSWORD=
#PDS_ACCESS_TOKEN=
#PDS_REFRESH_TOKEN=
# Labeler signing key (same key as the DID document's #atproto_label).
ATP_LABEL_SIGNING_KEY=
ATP_LABEL_KEY_MULTIBASE=
# Disk cache for cover bytes fetched from the catalog providers.
COVER_CACHE_DIR=./data/covers

# ─── Activity plane (HappyView) ─────────────────────────────────────────────
# `docker compose up -d` runs the local network: Postgres, a did-method-plc
# directory, a tranquil PDS, Caddy (TLS for the PDS) and this pinned HappyView.
# `mise run hv-account` mints the provisional account, `mise run hv-seed` makes
# it the superuser and writes the two credentials below.
HAPPYVIEW_URL=http://127.0.0.1:3000
# Compose pins happyview@sha256:a981c30c… (the 2.17.4 index digest).
HAPPYVIEW_IMAGE=ghcr.io/gamesgamesgamesgamesgames/happyview:2.17.4
# HappyView's tables live in a dedicated schema (its `labels` table collides
# with the AppView's). Its role's default search_path is `happyview,public`;
# DATABASE_URL above stays public-only.
HAPPYVIEW_DATABASE_URL=postgres://happyview_app:happyview@localhost:5432/bibliograph
# The provisional account. Its DID is a real did:plc in the local PLC; read it
# back with `mise run hv-seed` or the PDS's resolveHandle.
HAPPYVIEW_ACCOUNT_HANDLE=alice.pds.127-0-0-1.sslip.io
HAPPYVIEW_ACCOUNT_PASSWORD=Dev-account-password1
# Server-to-server credentials for `/xrpc/*`. The key identifies the caller for
# rate limiting; the secret proves the caller owns it. Queries are served to
# anonymous callers too — HappyView only *requires* the key on authenticated
# (DPoP) requests, and warns on an unknown one.
HAPPYVIEW_CLIENT_KEY=hvc_dev_client
HAPPYVIEW_CLIENT_SECRET=hvs_dev_secret
# `hv_` admin key: `Authorization: Bearer` on /admin/*, and what uploads
# lexicons and scripts.
HAPPYVIEW_ADMIN_KEY=hv_dev_admin

# ─── Feed generator (edge) ──────────────────────────────────────────────────
# Required, no code default. DID advertised by com.atproto.feed.describeFeedGenerator
# and the authority of every feed URI. Personalized feeds require a service JWT
# whose `aud` is <FEED_GENERATOR_DID>#atproto_feed. Change it only together with
# the hosted DID document (did:web) or the account it names (did:plc). When it is
# unset, both feed methods answer 503 ServiceUnavailable. The value below is the
# explicit local development identity.
FEED_GENERATOR_DID=did:web:biblio.livtet.olamaelcu.net

# ─── Local atproto network ──────────────────────────────────────────
# The PLC directory and PDS that HappyView resolves DIDs through, instead of
# plc.directory. The web edge resolves service-JWT signer DIDs through PLC_URL
# for the personalized feeds. Required, no code default: when it is unset or
# blank, following/extended/dynamic answer 503 ServiceUnavailable (`public` does
# not need it). Both are containers; these are the host-side addresses.
PLC_URL=http://127.0.0.1:2582
# HTTPS with Caddy's internal CA — `mise run hv-ca` trusts it in Chrome and
# Firefox, `mise run hv-ca --system` in the system store.
# The web edge proxies GET com.atproto.repo.getRecord/listRecords to this base
# URL (Livtet reads publisher records through it); the worker publishes here.
PDS_URL=https://pds.127-0-0-1.sslip.io

# ─── Admin UI ───────────────────────────────────────────────────────────────
# Operator token for /admin (Bearer header or `bib_admin` cookie). Unset
# disables the routes with 404, so a deployment without it has no write UI.
ADMIN_TOKEN=
# The worker's loopback admin API: provider search and candidate ingestion.
# The web edge proxies /admin/api/* here with ADMIN_TOKEN; the browser never
# talks to this port directly. Use port 0 for an ephemeral test listener.
WORKER_ADMIN_HOST=127.0.0.1
WORKER_ADMIN_PORT=9465
# Web edge only: where /admin/api/* forwards. Defaults to the loopback URL.
WORKER_ADMIN_URL=http://127.0.0.1:9465

# ─── Catalog providers ──────────────────────────────────────────────────────
# Google Books API key (https://console.cloud.google.com → Books API). Optional.
GOOGLE_BOOKS_API_KEY=
# ISBNDb API key (https://isbndb.com/apidocs/v2). Private server-side only.
ISBNDB_API_KEY=
# Hard cap on ISBNdb calls per UTC day. The worker reserves a call after a
# cache miss and before the HTTP request; cache hits and quota-exhausted
# lookups never reach the network. 0/negative is invalid (it falls back to
# 5000 with a warning), not unlimited.
ISBNDB_DAILY_LIMIT=5000
# OpenLibrary public API base URL. No key is needed; override only for a proxy
# or a local mirror. The provider is in the ISBN and text fallback chains and
# powers the read-only contributor search in the admin UI.
OPENLIBRARY_BASE_URL=https://openlibrary.org
# Worker Prometheus metrics (loopback by default). Prometheus scrapes /metrics;
# bind 0.0.0.0 only when a container or another host scrapes it.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=127.0.0.1

# ─── Labeler (librarian label) ──────────────────────────────────────────────
# Bootstrap admin allowlist: the admin UI is gated by ADMIN_TOKEN, and this list
# names the account recorded on labels it issues. Empty = publisher DID.
ADMIN_DIDS=
# `senior-librarian` eligibility: days since the first librarian label.
SENIOR_LIBRARIAN_MIN_DAYS=365

# Graphile Worker concurrency
GRAPHILE_WORKER_CONCURRENCY=10

# XRPC rate limits (requests per minute per IP)
RATE_LIMIT_RPM_PUBLIC=60
RATE_LIMIT_RPM_PDS=600
