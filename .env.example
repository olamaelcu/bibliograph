# Password for the TAP admin API (HTTP Basic auth on /repos/add, /channel, etc.).
# Username is always "admin". Generate with, e.g.: openssl rand -base64 32
TAP_ADMIN_PASSWORD=

# Bibliograph service
ORIGIN=http://localhost:5173
DATABASE_URL=postgres://bibliograph:bibliograph@localhost:5432/bibliograph
TAP_URL=http://localhost:2480
UPSTREAM_APPVIEW=https://public.api.bsky.app
BODY_SIZE_LIMIT=100M
PORT=5000
NODE_ENV=development

# Lex publisher (ATProto did:web:biblio.livtet.olamaelcu.net)
# Generate ATP_SIGNING_KEY + ATP_SERVICE_KEY_MULTIBASE with: mise run lex-keygen
# Both are also stored in infra/ansible/group_vars/all/secrets.sops.yml under
# bibliograph_signing_key and bibliograph_service_key_multibase.
ATP_SERVICE_HOST=biblio.livtet.olamaelcu.net
ATP_SIGNING_KEY=
ATP_SERVICE_KEY_MULTIBASE=
# Where prebuilt CAR files live (read at request time).
# Production: /app/data/lex (Dokku bind-mounted from /srv/data/bibliograph/data/lex).
# Local dev: $PWD/data/lex (created by mise run lex-build).
LEX_OUT_DIR=/app/data/lex

# Google Books API key (https://console.cloud.google.com → Books API). Optional.
# If unset, searchEditions still completes via OpenLibrary + Wikipedia.
GOOGLE_BOOKS_API_KEY=

# ISBNDb API key (https://isbndb.com/apidocs/v2). Private server-side only.
# Enables ISBNDb enrichment (POST /books) + cover fallback. Unset → degraded, no calls.
ISBNDB_API_KEY=

# ─── Labeler (librarian label) ──────────────────────────────────────────────
# K-256 keypair used to sign labels. Generate with `pnpm --filter
# bibliograph-service label-keygen`. The public half must be published in the
# DID document under #atproto_label — verifiers resolve it and check every
# signature against it. Keep it distinct from ATP_SIGNING_KEY so the labeler key
# can rotate independently (or set this to "same-as-repo" to reuse it locally).
ATP_LABEL_SIGNING_KEY=
ATP_LABEL_KEY_MULTIBASE=
# Comma-separated DIDs allowed to review the librarian queue at
# /admin/applications. Empty = nobody, so admin access fails closed.
ADMIN_DIDS=

# ─── ATProto OAuth (catalog curation sign-in) ───────────────────────────────
# Origin used to build the OAuth redirect URI. Loopback redirect URIs must use
# 127.0.0.1 (or [::1]); the OAuth spec rejects "localhost". Defaults to
# http://127.0.0.1:5176 when unset.
OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:5176
# Leave empty for local development: an ATProto loopback client id is generated
# with its metadata inline. In production set the HTTPS URL that serves
# /oauth-client-metadata.json, e.g.
# https://biblio.example.com/oauth-client-metadata.json
OAUTH_CLIENT_ID=
# Net votes (links minus unlinks) needed before a vote changes the catalog.
# 2 = consensus, so one dissenter cannot override an established link;
# 1 = a single account curates. Read at each tally, no restart needed.
EDITION_WORK_CONSENSUS_THRESHOLD=2

# Graphile Worker concurrency (search ingest vs TAP records)
GRAPHILE_WORKER_CONCURRENCY_SEARCH=10
GRAPHILE_WORKER_CONCURRENCY_TAP=25

# XRPC rate limits (requests per minute per IP)
RATE_LIMIT_RPM_PUBLIC=60
RATE_LIMIT_RPM_PDS=600

# Total search-pipeline timeout (ms) — bounds the whole request, not per upstream
REQUEST_TIMEOUT_MS=15000

# TAP backpressure: buffer events by either count or elapsed time, whichever first.
TAP_BATCH_SIZE=100
TAP_BATCH_INTERVAL_MS=500

# Conditional ack safety net: if graphile_worker.jobs depth for tap-record-*
# exceeds this threshold, tap-consumer skips enqueue + skip ack so TAP
# redelivers later. Throttled to 1 query/sec via in-process cache.
TAP_QUEUE_DEPTH_THRESHOLD=50000
