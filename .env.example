# Bibliograph service
ORIGIN=http://localhost:5176
DATABASE_URL=postgres://bibliograph:bibliograph@localhost:5432/bibliograph
# Local dev/E2E: resolve did:plc documents against the mock PLC instead of
# plc.directory. Unset in every deployment (the public registry is the default).
PLC_DIRECTORY_URL=http://127.0.0.1:2582
# HappyView's PLC origin when it runs inside the compose network (service DNS,
# not loopback). A host-run HappyView uses PLC_DIRECTORY_URL instead.
#HAPPYVIEW_PLC_URL=http://plc:2582
# Postgres connection budget. The host caps max_connections (50 on the packaged
# host); these maxima keep the app under it. Raise them only with the limit.
# PG_POOL_MAX=5                # web process read pool
# ENQUEUE_POOL_MAX=3           # web process job-enqueue pool
# GRAPHILE_WORKER_POOL=6       # worker pool
BODY_SIZE_LIMIT=100M
PORT=5000
NODE_ENV=development

# ─── Publishing identity ────────────────────────────────────────────────────
# ATProto did:web publisher. Its repo lives on the PDS below.
ATP_SERVICE_HOST=biblio.livtet.olamaelcu.net
ATP_SERVICE_KEY_MULTIBASE=
# Labeler signing key (same key as the DID document's #atproto_label).
ATP_LABEL_SIGNING_KEY=
ATP_LABEL_KEY_MULTIBASE=
# Disk cache for cover bytes fetched from the catalog providers.
COVER_CACHE_DIR=./data/covers

# ─── Activity plane (HappyView) ─────────────────────────────────────────────
# Internal HappyView origin. `/xrpc/*` is always served by SvelteKit; this is
# only the upstream the gateway calls.
HAPPYVIEW_URL=http://127.0.0.1:3000
# HappyView's tables live in a dedicated schema (its `labels` table collides
# with the AppView's). Its role's default search_path is `happyview,public`;
# `hv:dev` provisions that role locally. DATABASE_URL above stays public-only.
HAPPYVIEW_DATABASE_URL=postgres://happyview_app:happyview@localhost:5432/bibliograph
# Pin the local binary source; `mise run hv-extract` copies it into .cache/.
HAPPYVIEW_IMAGE=ghcr.io/gamesgamesgamesgamesgames/happyview:2.17.4
# Session-cookie secret for the local dashboard (>= 64 characters).
SESSION_SECRET=
# Public origin used when HappyView builds its own dashboard links.
HAPPYVIEW_PUBLIC_URL=http://127.0.0.1:5176
# Confidential API client the edge calls HappyView with.
HAPPYVIEW_CLIENT_KEY=
HAPPYVIEW_CLIENT_SECRET=
# `hv_` admin key used by hv:deploy and the dashboard admin API.
HAPPYVIEW_ADMIN_KEY=

# ─── PDS (rsky-pds) ─────────────────────────────────────────────────────────
# Loopback origin of the publisher PDS. Protocol endpoints are proxied here.
PDS_URL=http://127.0.0.1:2583
PDS_ACCOUNT_DID=did:web:biblio.livtet.olamaelcu.net
PDS_ACCOUNT_PASSWORD=
# Mock PLC store file used by `pnpm mock-plc` (optional; in-memory otherwise).
MOCK_PLC_STORE=./data/mock-plc.json
# Dev-only account used by `pnpm dev:seed`.
DEV_ACCOUNT_HANDLE=reader.test
DEV_ACCOUNT_PASSWORD=dev-account-password

# ─── Admin UI ───────────────────────────────────────────────────────────────
# Operator token for /admin (Bearer header or `bib_admin` cookie). Unset
# disables the routes with 404, so a deployment without it has no write UI.
ADMIN_TOKEN=

# ─── Catalog providers ──────────────────────────────────────────────────────
# Google Books API key (https://console.cloud.google.com → Books API). Optional.
GOOGLE_BOOKS_API_KEY=
# ISBNDb API key (https://isbndb.com/apidocs/v2). Private server-side only.
ISBNDB_API_KEY=

# ─── Labeler (librarian label) ──────────────────────────────────────────────
# Bootstrap admin allowlist: the admin UI is gated by ADMIN_TOKEN, and this list
# names the account recorded on labels it issues. Empty = publisher DID.
ADMIN_DIDS=
# `senior-librarian` eligibility: days since the first librarian label.
SENIOR_LIBRARIAN_MIN_DAYS=365

# Graphile Worker concurrency
GRAPHILE_WORKER_CONCURRENCY=10

# XRPC rate limits (requests per minute per IP)
RATE_LIMIT_RPM_PUBLIC=60
RATE_LIMIT_RPM_PDS=600
