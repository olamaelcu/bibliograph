# /etc/bibliograph/bibliograph.env — Bibliograph runtime configuration.
#
# Shipped as a dpkg conffile: `apt upgrade` never overwrites local edits, it
# prompts instead. Mode 0640 root:root — systemd reads it as PID 1 before
# dropping to the unprivileged "bibliograph" user, so secrets here are not
# readable by the service account on disk.
#
# REQUIRED entries have no default and no working value below. Leave one unset
# and the process logs the failure at boot and throws on the first request that
# reads it. The canonical schema is .env.example in the source tree.
#
# This file is read by all three units: the web process, the TAP worker, and
# the oneshot migrator.

# ───── Required: database ───────────────────────────────────────────────────
# PostgreSQL connection string. The package only Recommends postgresql, so a
# managed or remote instance is fine — point this at it and open the firewall.
#REQUIRED DATABASE_URL=postgres://bibliograph:CHANGEME@127.0.0.1:5432/bibliograph

# ───── Required: TAP consumer ───────────────────────────────────────────────
# The TAP service the worker subscribes to, and the admin password used to
# register the subscription. Without these the worker exits and restarts in a
# loop, and the index stops advancing.
#REQUIRED TAP_URL=https://tap.example
#REQUIRED TAP_ADMIN_PASSWORD=

# ───── Required: repository and label signing ───────────────────────────────
# K-256 keys, hex. ATP_SIGNING_KEY signs repository records under #atproto;
# ATP_LABEL_SIGNING_KEY signs labels under #atproto_label. Keep them distinct
# so the labeler key can rotate independently. Generate the labeler pair with
#   /usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx \
#     /usr/lib/bibliograph/packages/bibliograph-service/scripts/gen-label-key.ts
# and publish the public halves in the did:web document — a mismatch makes
# every signature invalid.
#REQUIRED ATP_SIGNING_KEY=
#ATP_SERVICE_KEY_MULTIBASE=
#REQUIRED ATP_LABEL_SIGNING_KEY=
#ATP_LABEL_KEY_MULTIBASE=

# did:web hostname the DID document and OAuth client metadata are served for.
ATP_SERVICE_HOST=biblio.livtet.olamaelcu.net

# Comma-separated DIDs allowed to review the librarian queue at
# /admin/applications. Empty = nobody, so admin access fails closed.
ADMIN_DIDS=

# ───── Filesystem layout ────────────────────────────────────────────────────
# Read-only directory of prebuilt lexicon CAR files served by the XRPC lex
# publisher. Created and owned by systemd (StateDirectory= in the unit) and
# populated out of band by the lex publish step; a missing file is a 404, not a
# crash.
LEX_OUT_DIR=/var/lib/bibliograph/lex

# pino writes one file per process here, alongside stdout. Created and owned by
# systemd (LogsDirectory=).
LOG_DIR=/var/log/bibliograph
#LOG_LEVEL=info

# ───── Reverse proxy (nginx) ────────────────────────────────────────────────
# The units bind 127.0.0.1 and nginx terminates TLS. These make adapter-node
# rebuild the public origin from the forwarded headers instead of from the
# loopback address it is actually listening on. Without ORIGIN the ATProto OAuth
# callback would be registered as http://127.0.0.1 and login would fail.
ORIGIN=https://biblio.livtet.olamaelcu.net
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Must match ORIGIN: this is the origin baked into the OAuth redirect URI.
OAUTH_PUBLIC_ORIGIN=https://biblio.livtet.olamaelcu.net
# Leave empty to let the client id be derived from OAUTH_PUBLIC_ORIGIN.
OAUTH_CLIENT_ID=

# PORT is NOT set here. It comes from /etc/bibliograph/port.conf, written by the
# package from the bibliograph/port debconf answer, and that file is read after
# this one. Change it with: dpkg-reconfigure bibliograph

# ───── Upstream enrichment (optional) ───────────────────────────────────────
UPSTREAM_APPVIEW=https://public.api.bsky.app
#GOOGLE_BOOKS_API_KEY=
#ISBNDB_API_KEY=

# ───── Catalogue rules ──────────────────────────────────────────────────────
# Votes needed before an edition→work link is rewritten.
EDITION_WORK_CONSENSUS_THRESHOLD=2
# Librarian eligibility thresholds for the review queue.
SENIOR_LIBRARIAN_MIN_DAYS=365
SENIOR_LIBRARIAN_MIN_VOTES=10

# ───── Throughput and limits ────────────────────────────────────────────────
GRAPHILE_WORKER_CONCURRENCY_SEARCH=10
GRAPHILE_WORKER_CONCURRENCY_TAP=25
RATE_LIMIT_RPM_PUBLIC=60
RATE_LIMIT_RPM_PDS=600
REQUEST_TIMEOUT_MS=15000
TAP_BATCH_SIZE=100
TAP_BATCH_INTERVAL_MS=500
TAP_QUEUE_DEPTH_THRESHOLD=50000

# ───── Observability (optional) ─────────────────────────────────────────────
#SENTRY_DSN=
