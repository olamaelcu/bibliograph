[Unit]
Description=Bibliograph Bookhive catalog refresh (one full walk)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
# The walk reads `edition_isbn_enrichment`-adjacent columns and writes editions,
# so it must not run against a database the migrator has not touched yet.
Requires=bibliograph-migrate.service

[Service]
Type=oneshot
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph/packages/bibliograph-service

Environment=NODE_ENV=production
EnvironmentFile=-/etc/bibliograph/bibliograph.env

# One full catalog walk: paged listRecords from Bookhive's PDS, then ISBN and
# contributor fills for the editions that lack them. Idempotent — rows already
# carrying an ISBN/contributor are skipped — so the weekly cadence only picks up
# what Bookhive added or changed. The walk is not rate-limited by a shared quota,
# but it writes one row per update; 4h covers a cold run under load.
ExecStart=/usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx scripts/backfill-bookhive-catalog.ts

TimeoutStartSec=4h
SuccessExitStatus=143 130
SyslogIdentifier=bibliograph-bookhive-catalog

StateDirectory=bibliograph
StateDirectoryMode=0750

# The walk logs through the worker logger, which writes under /var/log; with
# ProtectSystem=strict that path is read-only unless the unit owns it.
LogsDirectory=bibliograph
LogsDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

MemoryDenyWriteExecute=no
