[Unit]
Description=Bibliograph reader-directory backfill (seed DIDs, resolve identities)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
# `actors` comes from migration 0034, and a scan would only fill a table that is
# not there yet.
Requires=bibliograph-migrate.service

[Service]
Type=oneshot
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph/packages/bibliograph-service

Environment=NODE_ENV=production
EnvironmentFile=-/etc/bibliograph/bibliograph.env

# `searchActors` answers from `actors`, a read model that cannot be derived from
# `records`: no book record carries a handle, and Livtet's profile collection is
# outside TAP's filter. Phase 1 seeds one row per DID the mirror holds; phase 2
# resolves the stalest rows through app.bsky.actor.getProfiles (25 per call) and
# falls back to the DID document for the rest. Both phases are idempotent and
# `--limit` bounds what one tick can do; the whole current directory is ~1.1k
# DIDs, i.e. ~45 profile calls.
ExecStart=/usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx scripts/backfill-actors.ts --limit 2000

# Measured locally: 1,127 DIDs in 24s, dominated by the profile calls. A slow
# public AppView should not hold the unit open for the next tick.
TimeoutStartSec=15min
SuccessExitStatus=143 130
SyslogIdentifier=bibliograph-actors-backfill

StateDirectory=bibliograph
StateDirectoryMode=0750

# The script logs through the worker logger, which writes under /var/log; with
# ProtectSystem=strict that path is read-only unless the unit owns it.
LogsDirectory=bibliograph
LogsDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

MemoryDenyWriteExecute=no
