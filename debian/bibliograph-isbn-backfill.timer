[Unit]
Description=Run the Bibliograph ISBN backfill every 15 minutes
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
Requires=bibliograph-migrate.service

[Timer]
# First pass shortly after boot, then once a day. The scan is idempotent and
# skips rows that already have a queued job, so a daily cadence is enough for a
# backlog that only grows as fast as the catalog is imported.
OnBootSec=5min
OnCalendar=daily
# Spread across hosts: a synchronised fleet would hit OpenLibrary together.
RandomizedDelaySec=1h
AccuracySec=1min
# A run missed while the host was down fires on the next boot; the bounded batch
# and stamped rows make the catch-up harmless.
Persistent=true
Unit=bibliograph-isbn-backfill.service

[Install]
WantedBy=timers.target
