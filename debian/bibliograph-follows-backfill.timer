[Unit]
Description=Run the Bibliograph follower-graph backfill every hour
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
Requires=bibliograph-migrate.service

[Timer]
# Hourly at :20. The other ticks already own :40 (description, every hour),
# :25 (ISBN, daily) and the even hours at :00 (cover); this one takes a free
# minute so the scans do not queue behind each other on a single-vCPU host.
OnBootSec=40min
OnCalendar=*-*-* *:20:00
# Spread across hosts: a synchronised fleet would hit the public Constellation
# instance together. Small enough not to drift into the next hourly slot.
RandomizedDelaySec=5min
AccuracySec=1min
# A run missed while the host was down fires on the next boot; the scan is
# idempotent, so the catch-up costs one extra pass.
Persistent=true
Unit=bibliograph-follows-backfill.service

[Install]
WantedBy=timers.target
