[Unit]
Description=Bibliograph ISBN backfill (one bounded batch)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
# The bookkeeping columns (`isbn_enrich_at`, …) come from migration 0012, so the
# scan must not run against a database the migrator has not touched yet.
Requires=bibliograph-migrate.service

[Service]
Type=oneshot
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph/packages/bibliograph-service

Environment=NODE_ENV=production
EnvironmentFile=-/etc/bibliograph/bibliograph.env

# One bounded batch per daily run. The scan only reads unstamped rows without a
# queued job and enqueues `backfill-edition-isbn` jobs; the worker does the
# fetching, and graphile's jobKey keeps a slow worker from being handed the same
# row twice. The batch is sized to clear the ~165k missing-ISBN backlog in two
# daily ticks at the measured ~85k/day drain rate; an empty scan is one indexed
# query.
ExecStart=/usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx scripts/backfill-edition-isbns.ts --limit 83000

# Enqueueing 83k jobs sequentially takes 15-25 minutes on a cold tsx start, so
# the timeout has to cover the whole insert loop, not just a slow database.
TimeoutStartSec=1h
SuccessExitStatus=143 130
SyslogIdentifier=bibliograph-isbn-backfill

StateDirectory=bibliograph
StateDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

MemoryDenyWriteExecute=no
