[Unit]
Description=Run the Bibliograph description backfill every hour
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
Requires=bibliograph-migrate.service

[Timer]
# Hourly at :40. The ISBN tick is daily at 00:25 and the cover tick runs on the
# even hours at :00; the three share the Google Books quota, so the minute
# offsets keep their scans from racing for the same 429. The scan is idempotent
# and skips rows that already have a queued job.
OnBootSec=35min
OnCalendar=*-*-* *:40:00
# Spread across hosts: a synchronised fleet would hit Google Books together.
# Small enough not to drift into the next hourly slot.
RandomizedDelaySec=5min
AccuracySec=1min
# A run missed while the host was down fires on the next boot; the bounded batch
# and stamped rows make the catch-up harmless.
Persistent=true
Unit=bibliograph-description-backfill.service

[Install]
WantedBy=timers.target
