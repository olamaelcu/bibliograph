[Unit]
Description=Bibliograph cover backfill (one bounded batch)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service
Wants=network-online.target
# The bookkeeping column (`cover_checked_at`) comes from migration 0027, so the
# scan must not run against a database the migrator has not touched yet.
Requires=bibliograph-migrate.service

[Service]
Type=oneshot
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph/packages/bibliograph-service

Environment=NODE_ENV=production
EnvironmentFile=-/etc/bibliograph/bibliograph.env

# One bounded batch per tick: 1k rows every four hours (~6k/day), sized so the
# cover lookups stay a small share of the shared Google Books quota that the
# ISBN and description backfills also draw from. The scan only reads rows with
# no cover and no recent `cover_checked_at`, and enqueues
# `backfill-edition-cover` jobs; the worker does the fetching.
ExecStart=/usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx scripts/backfill-covers.ts --limit 1000

# A cold tsx start plus 1k sequential enqueues fits well inside this, but a slow
# database should not hold the unit open for the next tick.
TimeoutStartSec=30min
SuccessExitStatus=143 130
SyslogIdentifier=bibliograph-cover-backfill

StateDirectory=bibliograph
StateDirectoryMode=0750

# The scan logs through the worker logger, which writes under /var/log; with
# ProtectSystem=strict that path is read-only unless the unit owns it.
LogsDirectory=bibliograph
LogsDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

MemoryDenyWriteExecute=no
