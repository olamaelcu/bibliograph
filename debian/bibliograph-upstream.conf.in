# Generated by the bibliograph package postinst from the `bibliograph/port`
# debconf answer. Do not edit — run `dpkg-reconfigure bibliograph` instead.
#
# The nginx site in /etc/nginx/sites-enabled/bibliograph-platform proxies to
# this upstream by name, so the port appears exactly here.
upstream bibliograph_backend {
    server 127.0.0.1:@PORT@;
}
