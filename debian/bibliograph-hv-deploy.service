[Unit]
Description=Bibliograph HappyView lexicon and script deploy (oneshot)
Documentation=https://github.com/olamaelcu/bibliograph
After=network-online.target bibliograph-migrate.service happyview.service
Wants=network-online.target
Requires=bibliograph-migrate.service

[Service]
Type=oneshot
User=bibliograph
Group=bibliograph
WorkingDirectory=/usr/lib/bibliograph/packages/bibliograph-service
Environment=NODE_ENV=production
EnvironmentFile=-/etc/bibliograph/bibliograph.env
ExecStart=/usr/lib/bibliograph/packages/bibliograph-service/node_modules/.bin/tsx happyview/deploy.ts
SyslogIdentifier=bibliograph-hv-deploy
RemainAfterExit=yes
