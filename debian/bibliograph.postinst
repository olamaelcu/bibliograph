#!/bin/sh
# Renders the two files that carry the application port, then reloads nginx
# only when the resulting configuration is valid. Installing or reconfiguring
# bibliograph must never leave nginx unable to start.
set -e

. /usr/share/debconf/confmodule

PORT_TEMPLATE=/usr/share/bibliograph/bibliograph-upstream.conf.in
PORT_FILE=/etc/bibliograph/port.conf
UPSTREAM_FILE=/etc/nginx/conf.d/bibliograph-upstream.conf

# The site is staged in sites-available and only symlinked into sites-enabled
# once its certificate exists. A site file referencing missing ssl_certificate
# paths makes `nginx -t` fail globally, which would keep nginx from reloading
# now and from starting after the next reboot — taking every other vhost on the
# host down with it. Staging is therefore inert until it can be valid.
SITE_AVAILABLE=/etc/nginx/sites-available/bibliograph-platform
SITE_ENABLED=/etc/nginx/sites-enabled/bibliograph-platform
SITE_CERT=/etc/letsencrypt/live/biblio.livtet.olamaelcu.net/fullchain.pem

enable_site_if_possible() {
    # -L as well as -e: an existing symlink counts as enabled even when its
    # target is momentarily missing, otherwise ln fails on the second run.
    if [ -e "$SITE_ENABLED" ] || [ -L "$SITE_ENABLED" ]; then
        return 0
    fi
    if [ ! -f "$SITE_CERT" ]; then
        echo "bibliograph: no certificate at $SITE_CERT, so the nginx site" >&2
        echo "bibliograph: was staged but NOT enabled. nginx is untouched." >&2
        echo "bibliograph: after obtaining the certificate, run:" >&2
        echo "bibliograph:   ln -s ../sites-available/bibliograph-platform $SITE_ENABLED" >&2
        echo "bibliograph:   nginx -t && systemctl reload nginx" >&2
        return 1
    fi
    ln -s ../sites-available/bibliograph-platform "$SITE_ENABLED"
}

render_port() {
    install -d -m 0755 /etc/bibliograph
    cat > "$PORT_FILE" <<EOF
# Generated by the bibliograph package from the bibliograph/port debconf answer.
# Do not edit — run "dpkg-reconfigure bibliograph" instead.
PORT=$1
EOF
    chmod 0644 "$PORT_FILE"

    install -d -m 0755 /etc/nginx/conf.d
    sed "s/@PORT@/$1/" "$PORT_TEMPLATE" > "$UPSTREAM_FILE"
    chmod 0644 "$UPSTREAM_FILE"
}

if [ "$1" = "configure" ]; then
    port=""
    db_get bibliograph/port || true
    port="$RET"
    case "$port" in
    '' | *[!0-9]*) port=5000 ;;
    esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || port=5000

    previous=""
    if [ -f "$PORT_FILE" ]; then
        previous="$(sed -n 's/^PORT=//p' "$PORT_FILE" | head -1)"
    fi

    render_port "$port"

    enable_site_if_possible || true

    if { [ -e "$SITE_ENABLED" ] || [ -L "$SITE_ENABLED" ]; } && command -v nginx >/dev/null 2>&1; then
        if nginx -t >/dev/null 2>&1; then
            if [ -d /run/systemd/system ]; then
                deb-systemd-invoke reload nginx >/dev/null 2>&1 || true
            fi
        else
            echo "bibliograph: nginx configuration is invalid, so nginx was NOT reloaded." >&2
            echo "bibliograph: the site file is $SITE_ENABLED," >&2
            echo "bibliograph: the generated upstream is $UPSTREAM_FILE, and TLS material" >&2
            echo "bibliograph: is expected in /etc/letsencrypt/live/biblio.livtet.olamaelcu.net/." >&2
            echo "bibliograph: nginx -t said:" >&2
            nginx -t 2>&1 | sed 's/^/bibliograph:   /' >&2 || true
        fi
    elif ! command -v nginx >/dev/null 2>&1; then
        echo "bibliograph: nginx is not installed, so the site was not enabled." >&2
    fi

    # The unit reads PORT from $PORT_FILE, so a changed port needs a restart.
    # Only restart on a real change, not on first install (nothing is running).
    if [ -n "$previous" ] && [ "$previous" != "$port" ] && [ -d /run/systemd/system ]; then
        deb-systemd-invoke restart bibliograph >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#

exit 0
