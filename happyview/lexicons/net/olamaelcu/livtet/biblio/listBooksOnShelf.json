{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.listBooksOnShelf",
  "description": "List the books on a given shelf: its bookStatus rows and its shelfItem memberships, newest first.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["shelf"],
        "properties": {
          "shelf": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the shelf to list books for."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of shelf entries to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bookShelves"],
          "properties": {
            "bookShelves": {
              "type": "array",
              "items": {
                "type": "union",
                "refs": [
                  "net.olamaelcu.livtet.biblio.defs#bookShelfView",
                  "net.olamaelcu.livtet.biblio.defs#shelfItemView"
                ]
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "NotFound",
          "description": "No shelf record exists at the given AT-URI."
        }
      ]
    }
  }
}
