{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.follow",
  "description": "A follow relationship to a person (DID), used for personalizing feeds. The rkey is the followed DID, so a person can only be followed once.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did",
            "description": "DID of the followed person."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
