{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.getShelversOfBook",
  "description": "List the DIDs that put a given book on one of their shelves.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["bookUri"],
        "properties": {
          "bookUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the catalog book whose shelvers to list."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum number of distinct DIDs to return."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["bookUri", "dids"],
          "properties": {
            "bookUri": {
              "type": "string",
              "format": "at-uri",
              "description": "The book the DIDs shelved, echoed from the request."
            },
            "dids": {
              "type": "array",
              "description": "Distinct DIDs, in the order their shelving record was found.",
              "items": {
                "type": "string",
                "format": "did"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor; absent when no further DIDs are known."
            }
          }
        }
      }
    }
  }
}
