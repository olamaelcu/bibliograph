{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.graph.unfollow",
  "description": "Unfollow a person by DID: deletes the follow record at at://<caller>/net.olamaelcu.livtet.biblio.follow/<subject did>.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Unfollow a DID. Answers NotFound when the follow does not exist.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["subject"],
          "properties": {
            "subject": {
              "type": "string",
              "format": "did",
              "description": "DID of the person to unfollow."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri",
              "description": "AT-URI of the deleted follow record."
            }
          }
        }
      }
    }
  }
}
