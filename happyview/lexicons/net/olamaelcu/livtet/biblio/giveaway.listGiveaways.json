{
  "lexicon": 1,
  "id": "net.olamaelcu.livtet.biblio.giveaway.listGiveaways",
  "description": "List author giveaways from the activity index, newest first. Narrow by `uri`, `author`, `edition` or `status`; an unknown `uri` answers an empty list rather than `RecordNotFound`, so a page can ask about a giveaway that has already been deleted.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "One giveaway record's AT-URI."
          },
          "author": {
            "type": "string",
            "format": "did",
            "description": "The repo the giveaway records are written into."
          },
          "edition": {
            "type": "string",
            "format": "at-uri",
            "description": "The edition being given away."
          },
          "status": {
            "type": "string",
            "knownValues": ["open", "closed"],
            "description": "`open` means `opensAt <= now < closesAt`; `closed` is everything else, including a cancelled giveaway."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Opaque pagination cursor."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["giveaways"],
          "properties": {
            "giveaways": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "net.olamaelcu.livtet.biblio.defs#giveawayView"
              }
            },
            "cursor": {
              "type": "string",
              "description": "Opaque pagination cursor; absent when no further giveaways are known."
            }
          }
        }
      }
    }
  }
}
