#!/usr/bin/env python3
"""Upload Bibliograph's lexicons and scripts to HappyView, apply indexes, and
optionally bootstrap the admin credentials a fresh install needs.

One implementation for both callers: `mise run hv-deploy` (compose) and the
`bibliograph-happyview-deploy.service` oneshot the Debian package installs.

Environment:
  HAPPYVIEW_URL            base URL (default http://127.0.0.1:3000)
  HAPPYVIEW_ADMIN_KEY      `hv_` admin key
  HAPPYVIEW_ADMIN_KEY_FILE read the key from this file instead (takes precedence)
  HV_PSQL                  command used for SQL, shell-split; e.g.
                           "docker compose exec -T postgres psql -U bibliograph -d bibliograph"
  HV_DATABASE_URL          used when HV_PSQL is unset: runs plain `psql <dsn>`
  HV_ADMIN_DID             DID recorded for the seeded user (default did:web:<hostname>)

Options:
  --wait SECONDS     wait for /health before talking to the API (default 0)
  --seed             create the admin user/key first (needs SQL access)
  --root DIR         HappyView tree with lexicons/, scripts/, sql/ (default: ../)
  --no-indexes       skip applying sql/indexes.sql
  --admin-key-out FILE where --seed writes a generated key (default: none)

Exit status is non-zero if HappyView rejects an upload or SQL fails, so a
systemd oneshot surfaces the failure instead of half-deploying silently.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

RECORD_LEXICONS = [
    "net.olamaelcu.livtet.biblio.bookStatus",
    "net.olamaelcu.livtet.biblio.shelf",
    "net.olamaelcu.livtet.biblio.shelfItem",
    "net.olamaelcu.livtet.biblio.follow",
    "net.olamaelcu.livtet.biblio.readingGoal",
    "net.olamaelcu.livtet.actor.profile",
    "community.lexicon.media.book.review",
]

QUERY_LEXICONS = [
    ("net.olamaelcu.livtet.biblio.graph.isFollowing", "net.olamaelcu.livtet.biblio.follow"),
    ("net.olamaelcu.livtet.biblio.graph.listFollowers", "net.olamaelcu.livtet.biblio.follow"),
    ("net.olamaelcu.livtet.biblio.graph.listFollowees", "net.olamaelcu.livtet.biblio.follow"),
    ("net.olamaelcu.livtet.biblio.getReadingGoal", "net.olamaelcu.livtet.biblio.readingGoal"),
    ("net.olamaelcu.livtet.biblio.getActorProfile", "net.olamaelcu.livtet.actor.profile"),
    ("net.olamaelcu.livtet.biblio.getShelf", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.listShelves", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.listShelvesWithBooks", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.getShelvingOfBook", "net.olamaelcu.livtet.biblio.bookStatus"),
    ("net.olamaelcu.livtet.biblio.getShelversOfBook", "net.olamaelcu.livtet.biblio.bookStatus"),
    ("net.olamaelcu.livtet.biblio.listBooksOnShelf", "net.olamaelcu.livtet.biblio.bookStatus"),
    ("net.olamaelcu.livtet.biblio.listRecentShelving", "net.olamaelcu.livtet.biblio.bookStatus"),
    ("net.olamaelcu.livtet.biblio.getBookOnShelf", "net.olamaelcu.livtet.biblio.bookStatus"),
    ("net.olamaelcu.livtet.biblio.listShelfItems", "net.olamaelcu.livtet.biblio.shelfItem"),
    ("net.olamaelcu.livtet.biblio.listShelfItemsByBook", "net.olamaelcu.livtet.biblio.shelfItem"),
    ("net.olamaelcu.livtet.biblio.getReviewsByBook", "community.lexicon.media.book.review"),
    ("net.olamaelcu.livtet.biblio.listReviewsByActor", "community.lexicon.media.book.review"),
]

PROCEDURE_LEXICONS = [
    ("net.olamaelcu.livtet.biblio.graph.follow", "net.olamaelcu.livtet.biblio.follow"),
    ("net.olamaelcu.livtet.biblio.graph.unfollow", "net.olamaelcu.livtet.biblio.follow"),
    ("net.olamaelcu.livtet.biblio.shelf.create", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.shelf.update", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.shelf.delete", "net.olamaelcu.livtet.biblio.shelf"),
    ("net.olamaelcu.livtet.biblio.shelf.addItem", "net.olamaelcu.livtet.biblio.shelfItem"),
    ("net.olamaelcu.livtet.biblio.shelf.removeItem", "net.olamaelcu.livtet.biblio.shelfItem"),
