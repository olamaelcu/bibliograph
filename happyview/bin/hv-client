#!/usr/bin/env python3
"""Seed the confidential XRPC client the SvelteKit edge authenticates with, and
write its credentials where the edge can read them.

Runs before HappyView starts (bibliograph-happyview-client.service is ordered
Before=happyview.service), because HappyView loads client identities into memory
at boot: a row inserted afterwards would not be recognised until a restart.

The raw secret exists only in the written file and in this process — HappyView
stores its SHA-256. Both values are reused across runs, so re-running rotates
nothing; pass --force to mint a new pair (the edge then needs a restart to pick
it up).

Environment:
  DATABASE_URL / HV_DATABASE_URL / HV_PSQL   how to reach the database
  HV_CLIENT_URI      registered client_uri (default http://127.0.0.1:5176)
  HV_CLIENT_SCOPES   scopes the client may request
                     (default "atproto transition:generic")

Options:
  --out PATH         credentials file (default /etc/bibliograph/happyview-client.env)
  --force            mint a new key/secret even if the file already has one
  --client-uri URI   override HV_CLIENT_URI
  --client-key/-secret KEY  use supplied values instead of generating
"""

from __future__ import annotations

import argparse
import hashlib
import os
import secrets
import sys

import hvlib

DEFAULT_OUT = "/etc/bibliograph/happyview-client.env"
DEFAULT_URI = "http://127.0.0.1:5176"
DEFAULT_SCOPES = "atproto transition:generic"
CLIENT_ID = "c_install_edge"
CREATED_BY = "u_install_admin"
SQL = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "sql", "client-bootstrap.sql")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--out", default=DEFAULT_OUT)
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--client-uri", default=os.environ.get("HV_CLIENT_URI", DEFAULT_URI))
    parser.add_argument("--client-key")
    parser.add_argument("--client-secret")
    args = parser.parse_args()

    existing = {} if args.force else hvlib.read_kv_file(args.out)
    client_key = args.client_key or existing.get("HAPPYVIEW_CLIENT_KEY") or f"hvc_{secrets.token_hex(16)}"
    client_secret = (
        args.client_secret
        or existing.get("HAPPYVIEW_CLIENT_SECRET")
        or f"hvs_{secrets.token_hex(24)}"
    )
    scopes = os.environ.get("HV_CLIENT_SCOPES", DEFAULT_SCOPES)

    try:
        with open(SQL, encoding="utf-8") as handle:
            sql = handle.read()
        hvlib.run_sql(
            sql,
            {
                "client_id": CLIENT_ID,
                "client_key": client_key,
                "client_uri": args.client_uri,
                "scopes": scopes,
                "created_by": CREATED_BY,
                "secret_hash": hashlib.sha256(client_secret.encode()).hexdigest(),
            },
        )
        hvlib.write_env_file(
            args.out,
            {"HAPPYVIEW_CLIENT_KEY": client_key, "HAPPYVIEW_CLIENT_SECRET": client_secret},
            0o640,
        )
    except (hvlib.ToolError, OSError) as err:
        print(f"hv-client: {err}", file=sys.stderr)
        return 1

    # The service runs as `bibliograph`; root owns the file and the group reads
    # it. A non-root invocation (tests) keeps whatever ownership it has.
    gid = None
    try:
        import grp

        gid = grp.getgrnam("bibliograph").gr_gid
    except (ImportError, KeyError):
        pass
    if gid is not None and os.geteuid() == 0:
        os.chown(args.out, 0, gid)

    print(f"client {client_key} registered; credentials in {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
