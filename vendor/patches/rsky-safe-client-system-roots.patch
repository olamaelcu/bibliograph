+/// The deployment's own trust anchors, added to reqwest's defaults.
+///
+/// reqwest's default store is webpki's compiled Mozilla roots, so a host the
+/// deployment serves with a certificate from its own CA — this stack's PDS,
+/// behind Caddy — fails the handshake no matter what the operating system
+/// trusts. The bundle here is the one the deployment curates (`/etc/ssl/certs`
+/// in the image, an image's anchors plus the local CA); a missing or
+/// unreadable file leaves the defaults untouched.
+fn with_system_roots(mut builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+    const BUNDLE: &str = "/etc/ssl/certs/ca-certificates.crt";
+    let Ok(pem) = std::fs::read(BUNDLE) else {
+        return builder;
+    };
+    let Ok(text) = String::from_utf8(pem) else {
+        return builder;
+    };
+    for block in text.split("-----END CERTIFICATE-----") {
+        let candidate = format!("{block}-----END CERTIFICATE-----\n");
+        if let Ok(cert) = reqwest::Certificate::from_pem(candidate.as_bytes()) {
+            builder = builder.add_root_certificate(cert);
+        }
+    }
+    builder
+}
