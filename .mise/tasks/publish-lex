#!/usr/bin/env bash
#MISE description="Publish happyview/lexicons/** as com.atproto.lexicon.schema records (idempotent)"
#
# Wraps scripts/publish-lexicons.mjs. Each `happyview/lexicons/**/*.json` is
# validated and written to the publisher repo with
# `com.atproto.repo.putRecord`, collection `com.atproto.lexicon.schema`,
# rkey = NSID; the record body is the document plus `$type`.
#
# Idempotent: an unchanged existing record is skipped, a changed one is
# updated, and every write is re-read to compare the stored value and CID.
# Safe to re-run.
#
# Configuration comes from the environment (mise loads `.env`):
#
#   PDS_URL
#   PDS_ACCOUNT_DID
#   PDS_ACCOUNT_PASSWORD   app password, or:
#   PDS_ACCESS_TOKEN       (+ optional PDS_REFRESH_TOKEN)
#
# ATP_SERVICE_DID (or ATP_SERVICE_HOST) may name the same identity; a mismatch
# is a configuration error. On an installed host the values live in
# /etc/bibliograph/{pds,worker}.env; export them into the task's environment
# rather than copying secrets onto a command line.
#
# Repo writes do not claim the namespace: consumers also require
# `_lexicon.<authority>` TXT to name the publishing DID. The script reports
# that distinction and warns when the TXT is absent or names another DID.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

command -v node >/dev/null 2>&1 || {
  printf 'ERROR: node is required (mise pins 26.3.0)\n' >&2
  exit 1
}

exec node scripts/publish-lexicons.mjs "$@"
