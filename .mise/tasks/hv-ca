#!/usr/bin/env bash
#MISE description="Export Caddy's internal root CA so the browser trusts https://pds.127-0-0-1.sslip.io"
# The PDS is served over TLS with Caddy's internal CA. Browsers do not trust it
# until it is imported once; every device that signs in does this itself.
#
# Chromium/Chrome: chrome://settings/certificates → Authorities → Import
# Firefox: about:preferences#privacy → View Certificates → Authorities → Import
# System trust (Debian/Ubuntu): see the printed command.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

OUT=".cache/caddy-root.crt"
mkdir -p .cache

if ! docker compose ps --status running --format '{{.Service}}' | grep -qx caddy; then
  echo "ERROR: the caddy service is not running; start the stack with 'docker compose up -d'" >&2
  exit 1
fi

docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt "$OUT" >/dev/null
echo "Exported Caddy's root CA to $OUT"
echo
echo "Import it into the browser you sign in with, or trust it system-wide:"
echo "  sudo cp $OUT /usr/local/share/ca-certificates/caddy-local.crt && sudo update-ca-certificates"
echo
echo "Verify afterwards:  curl -sS https://pds.127-0-0-1.sslip.io/xrpc/com.atproto.server.describeServer"
