#!/usr/bin/env bash
#MISE description="Build web, happyview and worker sequentially, then deploy them in dependency order"
# Thin wrapper. Build selection, upload, install order, database prerequisites
# and verification live in ./deploy.sh, so there is exactly one implementation.
#
# The three debs are built here, sequentially, and all must succeed before
# deploy.sh uploads anything: nothing is installed after a partial build.
#
# The order is web -> happyview -> worker, not the host install order.
# package-worker-payload runs `pnpm deploy --prod`, which prunes the workspace's
# dev dependency links (notably packages/web/node_modules/.bin/vite). Building
# web after that races the worker payload and fails, so web is built and
# packaged first; the worker payload is staged last. A repeat run restores the
# pruned links with `pnpm install --frozen-lockfile` before building web.
#
# Do not turn these into #MISE depends: mise may run dependencies concurrently,
# which reintroduces the same race and leaves vite missing under the web build.
#
# Install order on the host is dependency-first — bibliograph-happyview, then
# bibliograph-worker (whose /usr/lib/bibliograph-worker/sql/ is applied next),
# then bibliograph-web (Depends: bibliograph-happyview) last, so the edge is
# never exposed before its upstream and the worker.
#
# A host with the retired combined `bibliograph` package is detected in
# preflight. Without --replace-legacy the deploy aborts before uploading;
# with it, the old package is stopped/purged before the worker install and the
# new vhost plus an HTTPS loopback check are required before DEPLOY_OK.
# Before upload, --replace-legacy also requires a staged worker.env with a valid
# DATABASE_URL, a staged web.env with HAPPYVIEW_URL (PORT optional), working
# nginx and the vhost certificate; otherwise the old package/site is untouched.
#
# Usage:
#   mise run deploy                          -> veve@lescayes.ts.olamaelcu.net
#   mise run deploy -- alice@server          another host
#   DEPLOY_HOST=alice@server mise run deploy
#   mise run deploy -- --dry-run             build sequentially, then print the plan; no ssh
#   mise run deploy -- --print-remote        print the remote script
#   mise run deploy -- --replace-legacy      stop/purge the retired combined
#                                            package and cut over explicitly
#   mise run deploy -- --skip-db             database provisioned elsewhere
#   mise run deploy -- --help                full option list

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

# Sequential, and web first: the worker payload's `pnpm deploy --prod` removes
# the workspace dev links the web build needs.
# The check runs `vite`, not `test -x` on its shim: a pruned workspace leaves a
# bin entry that can exist and not resolve, and `-x` then passes while the build
# falls through to whatever `vite` is on PATH (a Ruby gem, in this environment).
vite_usable() {
  ( cd "$ROOT/packages/web" && ./node_modules/.bin/vite --version >/dev/null 2>&1 )
}
if ! vite_usable; then
  printf '==> Restoring workspace dev links pruned by a previous worker payload\n'
  pnpm install --frozen-lockfile
  vite_usable || { printf 'ERROR: vite is still unusable after pnpm install\n' >&2; exit 1; }
fi
printf '==> Building bibliograph-web (before the worker payload prunes dev links)\n'
mise run package-web-deb
printf '==> Building bibliograph-happyview\n'
mise run package-hv-deb
printf '==> Building bibliograph-worker (payload staging prunes workspace dev links)\n'
mise run package-worker-deb

exec bash "$ROOT/deploy.sh" "$@"
