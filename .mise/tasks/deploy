#!/usr/bin/env bash
#MISE description="Deploy the newest built .deb to a host over ssh (no build; run 'mise run package-deb' first)"
# Thin wrapper. Upload, install, restart and verification live in ./deploy.sh so
# there is exactly one implementation, the same split platform's deploy /
# deploy-host pair uses.
#
# Usage:
#   mise run deploy                    newest dist/bibliograph_*.deb -> veve@lescayes
#   mise run deploy -- alice@server    another host
#   DEPLOY_HOST=alice@server mise run deploy
#   PKG=dist/bibliograph_0.1.3_amd64.deb mise run deploy

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

exec bash "$ROOT/deploy.sh" "$@"
