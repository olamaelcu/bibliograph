#!/usr/bin/env bash
#MISE description="Create the plc database on an existing pgdata volume and drop the abandoned pds one"
# docker/postgres-init.sql only runs when the Postgres data directory is
# created, so a volume from before the local atproto network existed lacks the
# plc database. This applies the same statement by hand, and drops the `pds`
# database an older volume still carries: the PDS moved to SQLite, so nothing
# connects to it any more. Idempotent.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

psql_() {
  docker compose exec -T postgres psql -U bibliograph -d bibliograph "$@"
}

if psql_ -tAc "SELECT 1 FROM pg_database WHERE datname='plc'" | grep -q 1; then
  echo "plc: exists"
else
  psql_ -q -c "CREATE DATABASE plc" >/dev/null
  echo "plc: created"
fi

if psql_ -tAc "SELECT 1 FROM pg_database WHERE datname='pds'" | grep -q 1; then
  psql_ -q -c "DROP DATABASE pds" >/dev/null
  echo "pds: dropped"
else
  echo "pds: absent"
fi
