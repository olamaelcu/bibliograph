#!/usr/bin/env bash
#MISE description="Build the SvelteKit edge and stage it as the web payload"
#
# The adapter-node output is self-contained: build/index.js pulls in nothing but
# Node built-ins, so the package ships ~2 MB of JavaScript and depends on the
# host's nodejs instead of bundling a runtime. Verified by running the staged
# tree with no node_modules beside it.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

OUT="packaging/payload/web"
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

printf '==> Building packages/web\n'
pnpm --filter web build 2>&1 | tail -3

[[ -f packages/web/build/index.js ]] || die "adapter-node emitted no build/index.js"
[[ -d packages/web/build/client ]] || die "adapter-node emitted no client assets"

rm -rf "$OUT"
mkdir -p "$OUT"
cp -a packages/web/build "$OUT/build"

# Fail closed on a payload that would install but not serve.
for required in build/index.js build/handler.js build/client/_app build/server; do
  [[ -e "$OUT/$required" ]] || die "payload is missing $required"
done

printf '==> Payload staged at ./%s\n' "$OUT"
du -sh "$OUT" "$OUT/build"
