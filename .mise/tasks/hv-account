#!/usr/bin/env bash
#MISE description="Create the provisional atproto account on the local PDS (did:plc registered in the local PLC)"
# Creates one account under the PDS's handle domain and nothing else. The
# account's DID is a real did:plc registered with the local PLC, so HappyView
# resolves it without touching plc.directory. Idempotent: an existing account
# is reported and left alone.
#
# The password is only needed to sign in to the PDS directly (or to complete the
# dashboard login in a browser); HappyView does not store it.

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$ROOT"

HANDLE="${1:-${HV_ACCOUNT_HANDLE:-alice.pds.127-0-0-1.sslip.io}}"
PASSWORD="${HV_ACCOUNT_PASSWORD:-Dev-account-password1}"
EMAIL="${HV_ACCOUNT_EMAIL:-alice@example.invalid}"
PDS="https://pds.127-0-0-1.sslip.io"

did_of() {
  python3 -c 'import json,sys; print(json.load(sys.stdin).get("did",""))' 2>/dev/null || true
}

existing="$(curl -sk -m 10 "$PDS/xrpc/com.atproto.identity.resolveHandle?handle=$HANDLE" | did_of)"
if [[ -n "$existing" ]]; then
  echo "account already exists: $HANDLE -> $existing"
  exit 0
fi

response="$(curl -sk -m 30 -X POST "$PDS/xrpc/com.atproto.server.createAccount" \
  -H 'Content-Type: application/json' \
  -d "{\"handle\":\"$HANDLE\",\"email\":\"$EMAIL\",\"password\":\"$PASSWORD\"}")"

did="$(printf '%s' "$response" | did_of)"
if [[ -z "$did" ]]; then
  echo "ERROR: account creation failed: $response" >&2
  exit 1
fi

echo "created $HANDLE -> $did"
echo "password: $PASSWORD"
