# Caddy terminates TLS for the PDS with its own internal CA — no ACME, no
# outbound traffic. `*.127-0-0-1.sslip.io` resolves to 127.0.0.1 through public
# DNS, so the host needs no /etc/hosts entry; it does need Caddy's root CA
# imported once (`mise run hv-ca`). HappyView is served directly on
# http://127.0.0.1:3000 (its OAuth client must be an `http` loopback client),
# and the catalog edge on http://127.0.0.1:5176; both also have a TLS site here
# for clients that cannot reach the host's loopback — the platform at
# https://172-17-0-1.sslip.io and the catalog at
# https://biblio.172-17-0-1.sslip.io — so the same names work from a container
# or an emulator.
#
# 80 redirects to 443 so an `http://` URL lands somewhere useful.

http://pds.127-0-0-1.sslip.io, http://*.pds.127-0-0-1.sslip.io {
	redir https://{host}{uri} permanent
}

# The canonical PDS origin: XRPC, the account pages, and the OAuth client
# metadata document (whose `client_id` names this host).
https://pds.127-0-0-1.sslip.io {
	tls internal
	reverse_proxy pds:3000
}

# Handle hosts exist for resolution and XRPC, not for the account pages.
# Those pages and the authorization screens belong on the one origin the PDS
# publishes its client metadata for, so redirect everything else — including
# `/` and `/account*` — to the canonical host.
https://*.pds.127-0-0-1.sslip.io {
	tls internal

	@handle_service path /.well-known/* /xrpc/*
	handle @handle_service {
		reverse_proxy pds:3000
	}
	handle {
		redir https://pds.127-0-0-1.sslip.io{uri} permanent
	}
}

# The Livtet dev app's own `did:web` host. `172-17-0-1.sslip.io` resolves to
# this container on the compose network (an alias below), so a `managedspace`
# policy naming
# `did:web:172-17-0-1.sslip.io#livtet_space_manager` resolves its document and
# calls `checkUserAccess` back through here; on the host the same name lands on
# the published :443. The app is a host process, reached through
# `host.docker.internal` so the route is this network's own gateway rather than
# a bridge a second compose project may not reach. `tls internal`, like every
# other site in this file — the PDS trusts this CA.
https://172-17-0-1.sslip.io {
	tls internal
	reverse_proxy host.docker.internal:6010
}

# The catalog edge, under the origin a mobile debug build names. Same shape as
# the platform's site above: a host process on :5176 reached through this
# network's gateway. The seeded HappyView client keeps its `client_uri` on
# `http://127.0.0.1:5176`, which is a loopback OAuth client by construction; this
# site exists so a device that cannot see the host's loopback still reaches the
# catalog over TLS.
https://biblio.172-17-0-1.sslip.io {
	tls internal
	reverse_proxy host.docker.internal:5176
}
