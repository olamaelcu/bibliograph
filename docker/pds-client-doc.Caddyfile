# The desktop dev build's OAuth client document, on the PDS's own loopback.
#
# `pds-client-doc` shares the PDS container's network namespace, so this is what
# the PDS reaches when it fetches `client_id http://localhost:6010/...` — a URL
# that would otherwise be the container itself and answer nothing. It forwards
# to the host's platform dev server through the Docker host gateway, so the
# document keeps a single source (the platform's own metadata route) and nothing
# else in this stack has to trust the platform's TLS or resolve a host name.
#
# Plain HTTP on purpose: `http://localhost` is the one client_id form an
# Authorization Server may fetch without TLS, and the platform serves the
# document on the same origin the desktop fetches it from.
http://localhost:6010 {
	# The host is this compose network's gateway: a shared network namespace
	# cannot carry `extra_hosts`, so the gateway is named directly. Docker's
	# default bridge pool keeps it stable for the life of the project.
	reverse_proxy 172.18.0.1:6010
}
