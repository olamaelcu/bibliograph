{
  "name": "bibliograph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:server": "tsc",
    "check": "tsc && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "NODE_ENV=production tsx src/index.ts",
    "dev": "vite",
    "dev:server": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "key:generate": "node scripts/generate-atproto-key.mjs",
    "release": "tsx src/release.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@atproto/crypto": "^0.5.4",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
