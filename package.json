{
  "name": "bibliograph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:server": "tsc",
    "check": "tsc && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "NODE_ENV=production tsx src/index.ts",
    "dev": "vite",
    "dev:server": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "dump:openlibrary": "tsx src/import/cli.ts openlibrary:dump",
    "dump:works": "tsx src/import/cli.ts works:dump",
    "dump:contributors": "tsx src/import/cli.ts contributors:dump",
    "bookhive:catalog": "tsx src/import/cli.ts bookhive:catalog",
    "images:refresh": "tsx src/import/cli.ts images:refresh",
    "review": "tsx src/review/cli.ts",
    "lex:gen": "lex-cli generate",
    "key:generate": "node scripts/generate-atproto-key.mjs",
    "release": "tsx src/release.ts",
    "lex:check": "atprotolex check lexicons/net/olamaelcu/livtet/biblio/*.json"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/client": "^5.1.1",
    "@atcute/cbor": "^2.3.6",
    "@atcute/cid": "^2.4.2",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/xrpc-server": "^2.0.2",
    "@awesome.me/webawesome": "^3.11.0",
    "@hono/node-server": "^2.0.12",
    "@lit-labs/ssr": "^4.1.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "opendal": "^0.49.6",
    "pino": "^10.3.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@atcute/lex-cli": "^3.2.1",
    "@atcute/lexicon-doc": "^3.0.2",
    "@atproto/crypto": "^0.5.4",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.0",
    "valibot": "^1.4.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
