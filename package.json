{
  "name": "bibliograph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && vite build --mode client",
    "build:client": "vite build --mode client",
    "build:server": "tsc",
    "check": "tsc && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "NODE_ENV=production tsx src/index.ts",
    "dev": "vite",
    "dev:server": "tsx watch src/index.ts",
    "lex:generate": "lex-cli generate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dump:openlibrary": "tsx src/dump/cli.ts",
    "release": "tsx src/release.ts",
    "backfill": "tsx src/backfill.ts",
    "backfill:contributors": "tsx src/backfill-contributors.ts",
    "dedup": "tsx src/dedup-job.ts"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.3",
    "@atcute/bluesky": "^4.0.17",
    "@atcute/cbor": "^2.3.6",
    "@atcute/client": "^5.1.1",
    "@atcute/lex-cli": "^3.2.1",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/uint8array": "^1.1.5",
    "@atcute/xrpc-server": "^2.0.2",
    "@atproto/tap": "^0.3.12",
    "@awesome.me/webawesome": "^3.11.0",
    "@hono/node-server": "^2.0.12",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "lucide-static": "^1.28.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true,
    "core-js@3.49.0": true
  }
}
